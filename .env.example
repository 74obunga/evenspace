# Local development only. Replace these values outside a local development machine.
POSTGRES_DB=evenspace
POSTGRES_USER=evenspace
POSTGRES_PASSWORD=evenspace-dev-only
POSTGRES_PORT=5432
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Payments stay disabled until a Daraja app and publicly reachable callback are configured.
PAYMENT_PROVIDER=none
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_BASE_URL=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@evenspace.local
SMTP_STARTTLS=true
NOTIFICATION_ENCRYPTION_KEY=

